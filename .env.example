# SynthWarden Configuration
# Copy this to .env and fill in your values

# UniFi Protect Connection
UNIFI_HOST=192.168.1.1
UNIFI_USER=synthwarden-user
UNIFI_PASS=your-password-here

# Security (generate a random 32+ character string)
SECRET_KEY=change-me-to-a-random-string

# Timezone
TZ=America/Chicago

# Optional: Debug mode (set to true for development)
DEBUG=false

# OpenClaw Integration (optional)
# Set an API key to secure the /api/openclaw/* endpoints
# CLAWDBOT_API_KEY=your-secret-api-key
